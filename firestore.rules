rules_version = '2';

// Правила доступа к базе команды прославления.
// Вставьте этот файл целиком: Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function rolesDoc() { return /databases/$(database)/documents/meta/roles; }
    function roles() { return get(rolesDoc()).data; }
    function isLeader() { return signedIn() && exists(rolesDoc()) && me() in roles().leaders; }
    function isMember() { return signedIn() && (exists(/databases/$(database)/documents/access/$(me())) || isLeader()); }
    // Отдельное право, выданное лидером во вкладке «Настройки»:
    // songs, schedule, notify, team, study, tasks.
    function can(p) { return isLeader() || (isMember() && p in roles().get('perms', {}).get(me(), [])); }

    // Лидеры и права. Первый вошедший может назначить себя, дальше меняют только лидеры.
    match /meta/roles {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.leaders == [me()];
      allow update: if isLeader() && request.resource.data.leaders.size() > 0;
    }

    // Кому открыт доступ (и кто он в списке служителей).
    match /access/{uid} {
      allow read: if isMember() || (signedIn() && me() == uid);
      allow write: if can('team') || (isLeader() && me() == uid);
    }

    // Заявки на вход: каждый пишет свою, лидер и право «Команда» читают и удаляют.
    match /requests/{uid} {
      allow read: if can('team') || (signedIn() && me() == uid);
      allow create, update: if signedIn() && me() == uid;
      allow delete: if can('team') || (signedIn() && me() == uid);
    }

    // Песни (вместе с каподастром) меняет лидер и право «Песни и категории».
    match /songs/{id} { allow read: if isMember(); allow write: if can('songs'); }
    match /categories/{id} { allow read: if isMember(); allow write: if can('songs'); }

    match /services/{id} { allow read: if isMember(); allow write: if can('schedule'); }
    match /events/{id}   { allow read: if isMember(); allow write: if can('schedule'); }
    match /members/{id}  { allow read: if isMember(); allow write: if can('team'); }
    // Лента: объявления пишут право «Сообщения» и «Расписание» (объявление состава, перестановки).
    match /feed/{id}     { allow read: if isMember(); allow write: if can('notify') || can('schedule'); }
    match /lessons/{id}  { allow read: if isMember(); allow write: if can('study'); }
    match /warmups/{id}  { allow read: if isMember(); allow write: if can('tasks'); }

    // Задачи: создаёт право «Задачи», отмечать пункты может вся команда.
    match /tasks/{id} {
      allow read: if isMember();
      allow create: if can('tasks');
      allow update: if can('tasks') || (isMember() && !('deleted' in request.resource.data));
      allow delete: if can('tasks');
    }

    // Предложенные песни: предлагает любой участник, менять может автор или право «Песни».
    match /suggestions/{id} {
      allow read: if isMember();
      allow create: if can('songs') || (isMember() && request.resource.data.by == me());
      allow update: if can('songs') || (isMember() && resource.data.by == me());
      allow delete: if can('songs');
    }

    // Свои отметки доступности и голоса: читает команда, пишет только владелец.
    match /avail/{uid} { allow read: if isMember(); allow write: if isMember() && me() == uid; }
    match /votes/{uid} { allow read: if isMember(); allow write: if isMember() && me() == uid; }

    // Конспекты и отзывы: видит автор и лидер.
    match /notes/{uid}    { allow read: if isLeader() || (isMember() && me() == uid); allow write: if isMember() && me() == uid; }
    match /feedback/{uid} { allow read: if isLeader() || (isMember() && me() == uid); allow write: if isMember() && me() == uid; }

    // Адреса для push-уведомлений: только свои. Рассылку делает сервер (GitHub Actions).
    match /tokens/{uid} { allow read, write: if signedIn() && me() == uid; }

    // Служебные отметки рассылки — только сервер.
    match /reminders/{id} { allow read, write: if false; }
  }
}
